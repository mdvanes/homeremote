STATUS_CMD=echo { \"field1\": \"field1value\", \"field2\": \"field2value\" }
STATUS_FIELD1=field1
STATUS_FIELD2=field2
URL_TO_MUSIC_ROOTPATH=/home/someuser/music/2021
OWNERINFO_UID=1000
OWNERINFO_GID=1000
DOWNLOAD_BASE_URL=http://localhost:1234/
DOWNLOAD_USERNAME=some_username
DOWNLOAD_PASSWORD=some_password
# Selects which download backend serves /api/downloadlist. Value can be "alpha" or "bravo"
DOWNLOAD_CLIENT=alpha
INFLUX_URL=https://some_url:8086
INFLUX_TOKEN=123
INFLUX_ORG=some_org
STEREO8_TOKEN=123
JUKEBOX_BASE_URL=http://localhost:1235/rest/
JUKEBOX_USERNAME=some_username
JUKEBOX_PASSWORD=some_password
JUKEBOX_SONGDIR_ID=1234
MONIT=username,password,http://192.168.0.1:80/_status?format=xml;username,password,http://192.168.0.1:80/_status?format=xml
TVSHOW_BASE_URL=http://192.168.0.1:1239
TVSHOW_API_KEY=abc
MOVIE_BASE_URL=http://192.168.0.1:1240
MOVIE_API_KEY=abc
NEXTUP_URL=http://192.168.0.1:1237
NEXTUP_API_TOKEN=123
NEXTUP_USER_ID=123
CARTWIN_VIN=123
CARTWIN_VCC_API_KEY=123
HOMESEC_BASE_URL=http://192.168.0.1/
HOMESEC_USERNAME=user
HOMESEC_PASSWORD=pass
DOCKER_BASE_URL=http://192.168.0.1
PORTAINER_BASE_URL=http://192.168.0.1:9000
PORTAINER_API_KEY=abc
CADDY_BASE_URL=http://192.168.0.1:2019
SERVICES_CONFIG_PATH=/config/services-links.yaml
HOMEASSISTANT_BASE_URL=http://192.168.0.1:8123
HOMEASSISTANT_TOKEN=abc
HOMEASSISTANT_TEMPERATURE_SENSOR_ID=sensor.tz3000_1_temperature,sensor.1_humidity
# Gas sensors are listed oldest to newest; the meter device was replaced twice, so multiple
# entity ids are aggregated (each series is only non-zero while its device was active).
HOMEASSISTANT_GASTEMPERATURE_SENSOR_ID=sensor.tfa_dostmann_rf_temp,sensor.temperature_2,sensor.domoticz_gas,sensor.gas_meter_gas_consumption,sensor.universal_p1_port_dongle_gas_delivered
HOMEASSISTANT_WATER_SENSOR_ID=sensor.liters
# Electricity sensors are listed per tariff group, old device then new device (old,new,old,new,...).
HOMEASSISTANT_ELECTRA_SENSOR_ID=sensor.electricity_meter_energy_consumption_tarif_1,sensor.universal_p1_port_dongle_energy_delivered_tariff_1,sensor.electricity_meter_energy_consumption_tarif_2,sensor.universal_p1_port_dongle_energy_delivered_tariff_2,sensor.electricity_meter_energy_production_tarif_1,sensor.universal_p1_port_dongle_energy_delivered_returned_1,sensor.electricity_meter_energy_production_tarif_2,sensor.universal_p1_port_dongle_energy_delivered_returned_2
HOMEASSISTANT_SWITCHES_ID=group.favorites
HOMEASSISTANT_TRACKER_IDS=sensor.tracker1,sensor.tracker2
